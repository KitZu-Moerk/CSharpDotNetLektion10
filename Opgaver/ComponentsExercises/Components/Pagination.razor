<nav aria-label="Sidepaginering">
    <ul class="pagination mb-0">

        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
            <button class="page-link"
                    type="button"
                    disabled="@(CurrentPage == 1)"
                    @onclick="() => ChangePage(CurrentPage - 1)">
                Forrige
            </button>
        </li>

        @for (int i = 1; i <= TotalPages; i++)
        {
            int pageNumber = i;

            <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                <button class="page-link"
                        type="button"
                        @onclick="() => ChangePage(pageNumber)">
                    @pageNumber
                </button>
            </li>
        }

        <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
            <button class="page-link"
                    type="button"
                    disabled="@(CurrentPage >= TotalPages)"
                    @onclick="() => ChangePage(CurrentPage + 1)">
                Næste
            </button>
        </li>


    </ul>
</nav>


    // Starter kode:
    // Modtag parametre for nuværende side, samlet antal elementer og sidestørrelse.
    // Beregn det samlede antal sider og generer sidetallene dynamisk.
    // Underret forældresiden via en EventCallback, når brugeren vælger en ny side.

    @code {
        [Parameter] public int TotalItems { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 5;

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    private int TotalPages =>
        (int)Math.Ceiling((double)TotalItems / PageSize);

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    private async Task ChangePage(int newPage)
    {
        if (newPage == CurrentPage || newPage < 1 || newPage > TotalPages)
        {
            return;
        }

        await PageChanged.InvokeAsync(newPage);
    }
    }
}