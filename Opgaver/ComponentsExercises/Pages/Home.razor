@page "/"
@using ComponentsExercises.Components

<PageTitle>Components Opgaver</PageTitle>

<button class="btn btn-primary" onclick="@OpenModal">Åbn Modal</button>

<Modal
    IsOpen="isModelOpen" Title="Min titel" OnClose="CloseModal"> 
    <p>Hej med dig</p>
</Modal>

@code {

    private bool isModelOpen = false;
    private void OpenModal() => isModelOpen = true;
    private void CloseModal() => isModelOpen = false; 
}