@page "/pagination"
@using ComponentsExercises.Components

<PageTitle>Produktoversigt (Paginering)</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📦 Produktoversigt</h5>
            <span class="badge bg-light text-dark">Side @currentPage af @totalPages</span>
        </div>
        <div class="card-body">
            <p class="text-muted">
                Denne side viser en liste over produkter opdelt i sider. Forbind og tilpas
                <code>Pagination</code>-komponenten forneden, så tabellen dynamisk viser de rigtige produkter for den valgte side.
            </p>

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">#</th>
                            <th>Varenavn</th>
                            <th>Kategori</th>
                            <th class="text-end">Pris</th>
                            <th class="text-center">Lager</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in displayedProducts)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@product.Id</span></td>
                                <td class="fw-semibold">@product.Name</td>
                                <td><span class="badge bg-info text-dark">@product.Category</span></td>
                                <td class="text-end">@product.Price.ToString("C0", new System.Globalization.CultureInfo("da-DK"))</td>
                                <td class="text-center">
                                    @if (product.InStock)
                                    {
                                        <span class="badge bg-success">På lager</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Udsolgt</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                <div class="text-muted small">
                    Viser @displayedProducts.Count() ud af @products.Count produkter
                </div>

                <!-- Starter kode: Forbind Pagination-komponenten her -->
                <Pagination TotalItems="@products.Count"
                    PageSize="@pageSize"
                    CurrentPage="@currentPage"
                    PageChanged="HandlePageChanged" />
                </div>
        </div>
    </div>
</div>

@code {
    private int currentPage = 1;
    private int pageSize = 5;

    private int totalPages => (int)Math.Ceiling((double)products.Count / pageSize);

    private IEnumerable<Product> displayedProducts =>
        products.Skip((currentPage - 1) * pageSize).Take(pageSize);

    // Starter kode: Tilknyt denne metode eller opdater currentPage direkte fra komponenten
    private void HandlePageChanged(int newPage)
    {
        currentPage = newPage;
    }

    private readonly List<Product> products = new()
